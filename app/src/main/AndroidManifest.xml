<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- v1.5: only so the settings keep-alive card can OPEN the
         system's battery-whitelist page for the user; the app never
         changes any system setting itself. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- v1.6: only for the scan-to-add screen; the camera is opened
         solely while that screen is in front of the user. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- v2.6: only for the (default-off)「开机后自动恢复未完成任务」
         switch; with the switch off the receiver returns instantly
         and nothing runs at boot beyond that check. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="TuxunDown"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- v2.7: long-press icon shortcuts （新建下载 /
                 打开嗅探）; the intents land on the actions
                 MainActivity handles via ShortcutState. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <activity
            android:name=".SniffActivity"
            android:exported="false"
            android:label="嗅探浏览器" />
        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:label="扫码添加" />
        <service
            android:name=".core.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- v2.7: quick-settings tile （全部暂停 / 全部继续）.
             exported=true is required — the system binds the
             tile — and the BIND_QUICK_SETTINGS_TILE permission
             is what keeps anything else from binding it. -->
        <service
            android:name=".core.DownloadTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_download"
            android:label="TuxunDown 下载"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- v2.6: boot entry for the 开机恢复 switch (default off).
             exported=false: only the system may deliver the boot
             broadcast to it. -->
        <receiver
            android:name=".core.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <!-- v3.5: landing spot for the scheduled-start backup
             alarm (see ScheduleWake). exported=false: only this
             app's own AlarmManager PendingIntent can deliver
             to it. No new permission — the alarm is inexact
             (setAndAllowWhileIdle). -->
        <receiver
            android:name=".core.ScheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.tuxundown.android.action.SCHEDULE_WAKE" />
            </intent-filter>
        </receiver>
        <!-- v3.8 audit round 24: post-upgrade tidy-up — the
             system delivers MY_PACKAGE_REPLACED to the updated
             app itself; the receiver re-arms the scheduled-start
             backup alarm and refreshes placed widgets from the
             new APK's resources (see UpgradeReceiver).
             exported=false: only the system can deliver it. -->
        <receiver
            android:name=".core.UpgradeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- v2.1: home-screen widget (in-flight task count + total
             progress). Updates are pushed by the download service;
             the provider only answers the launcher's broadcasts,
             which come from the system — exported=false is the
             documented shape for an AppWidgetProvider. -->
        <receiver
            android:name=".widget.DownloadWidgetProvider"
            android:exported="false"
            android:label="TuxunDown 下载进度">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_download_info" />
        </receiver>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.tuxundown.android.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
